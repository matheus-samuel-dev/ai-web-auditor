# Copie este arquivo para .env antes de executar o Docker Compose.
# Gere valores aleatorios e exclusivos; nunca reutilize estes exemplos em producao.
POSTGRES_DB=ai_web_auditor
POSTGRES_USER=ai_admin
POSTGRES_PASSWORD=substitua-por-uma-senha-forte

APP_JWT_SECRET=substitua-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
APP_AUDITOR_API_TOKEN=substitua-por-um-token-interno-aleatorio
APP_AUDITOR_CALLBACK_TOKEN=substitua-por-outro-token-interno-aleatorio

APP_JWT_EXPIRATION_MINUTES=1440
APP_AUDITOR_REQUEST_TIMEOUT_SECONDS=900
AUDITOR_TIMEOUT_SECONDS=900
AUDITOR_TIMEOUT_MS=120000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
